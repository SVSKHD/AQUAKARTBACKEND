FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
JWT_SECRET=
INVOICE_ACCESS_SECRET=
INVOICE_ACCESS_TOKEN_EXPIRY_MINUTES=15
INVOICE_ACCESS_SESSION_EXPIRY=30m
FRONTEND_PUBLIC_URL=https://aquakart.co.in
# Backward-compatible alias used by older deployments
FRONTEND_URL=https://aquakart.co.in
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Aquakart Support
SMTP_FROM_EMAIL=
# Backward-compatible full From header
EMAIL_FROM=
# Fast2SMS WhatsApp Business templates. Never commit the real API key.
FAST2SMS_API_KEY=
FAST2SMS_WHATSAPP_PHONE_NUMBER_ID=
FAST2SMS_WHATSAPP_INVOICE_MESSAGE_ID=
FAST2SMS_BASE_URL=https://www.fast2sms.com

# Reserved for the later SMS phase; no SMS sender is active yet.
FAST2SMS_SMS_ENABLED=false
FAST2SMS_SMS_ROUTE=dlt
FAST2SMS_SMS_SENDER_ID=
FAST2SMS_SMS_INVOICE_MESSAGE_ID=

# Daily reminder for invoices not yet linked to a verified customer account.
INVOICE_REMINDER_ENABLED=true
INVOICE_REMINDER_HOUR_IST=8
INVOICE_REMINDER_BATCH_SIZE=100

# Commerce platform
ADMIN_BOOTSTRAP_KEY=
STANDARD_DELIVERY_CHARGE=50
ECOM_BASE_URL=https://aquakart.co.in
API_BASE_URL=https://api.aquakart.co.in
