FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
JWT_SECRET=
INVOICE_ACCESS_SECRET=
INVOICE_ACCESS_TOKEN_EXPIRY_MINUTES=15
INVOICE_ACCESS_SESSION_EXPIRY=30m
FRONTEND_PUBLIC_URL=https://aquakart.co.in
# Backward-compatible alias used by older deployments
FRONTEND_URL=https://aquakart.co.in
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Aquakart Support
SMTP_FROM_EMAIL=
# Backward-compatible full From header
EMAIL_FROM=
# Fast2SMS WhatsApp Business templates. Never commit the real API key.
FAST2SMS_API_KEY=
FAST2SMS_WHATSAPP_PHONE_NUMBER_ID=
FAST2SMS_WHATSAPP_INVOICE_MESSAGE_ID=
FAST2SMS_BASE_URL=https://www.fast2sms.com

# Reserved for the later SMS phase; no SMS sender is active yet.
FAST2SMS_SMS_ENABLED=false
FAST2SMS_SMS_ROUTE=dlt
FAST2SMS_SMS_SENDER_ID=
FAST2SMS_SMS_INVOICE_MESSAGE_ID=

# Weekly reminder for invoices not yet linked to a verified customer account.
# Day of week uses JavaScript numbering: 0=Sunday, 1=Monday, ..., 6=Saturday.
INVOICE_REMINDER_ENABLED=true
INVOICE_REMINDER_DAY_OF_WEEK_IST=1
INVOICE_REMINDER_HOUR_IST=8
INVOICE_REMINDER_BATCH_SIZE=100

# Commerce platform
ADMIN_BOOTSTRAP_KEY=
STANDARD_DELIVERY_CHARGE=50
ECOM_BASE_URL=https://aquakart.co.in
API_BASE_URL=https://api.aquakart.co.in
PHONEPE_MERCHANTID=
PHONEPE_KEY=
PHONEPE_KEY_INDEX=1
PHONEPE_BASE_URL=https://api.phonepe.com/apis/hermes

# Storefront AI chat: questions per IST day. Guests are counted per IP,
# signed-in customers per account (defaults 3 and 10). Admin/tester accounts
# are unlimited.
AI_GUEST_DAILY_LIMIT=
AI_USER_DAILY_LIMIT=

# Aquakart MCP server (ChatGPT / Claude connectors). Off unless
# MCP_PUBLIC_BASE_URL is set to this API's public HTTPS origin; the MCP
# endpoint is <origin>/v1/mcp and OAuth lives at the origin root. See
# docs/MCP_BLOG_PUBLISHING.md.
MCP_PUBLIC_BASE_URL=
# Storefront origin for public blog URLs (falls back to FRONTEND_PUBLIC_URL).
MCP_STOREFRONT_URL=
# Comma-separated OAuth redirect URIs (trailing * = prefix). Default covers
# ChatGPT and Claude; loopback (Claude Code) is controlled separately.
MCP_OAUTH_ALLOWED_REDIRECT_URIS=
MCP_OAUTH_ALLOW_LOOPBACK_REDIRECTS=
MCP_ACCESS_TOKEN_TTL_SECONDS=
MCP_REFRESH_TOKEN_TTL_DAYS=
MCP_RATE_LIMIT_PER_MINUTE=
# Hosts allowed for ChatGPT file-param downloads (default *.oaiusercontent.com).
MCP_TRUSTED_FILE_HOSTS=
MCP_IMAGE_MAX_BYTES=
MCP_PUBLISH_MIN_WORDS=
MCP_PUBLISH_REQUIRE_TITLE_IMAGE=
MCP_PUBLISH_REQUIRE_SHORT_DESCRIPTION=
MCP_OPERATION_RETENTION_DAYS=
# Cloudinary public id of the official logo for branded blog header images.
AQUAKART_LOGO_PUBLIC_ID=
MCP_LOGO_GRAVITY=
MCP_LOGO_WIDTH_RATIO=

# Instagram Content Publishing (Meta Graph API). Never commit the token.
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
# https://graph.facebook.com (Facebook Login) or https://graph.instagram.com
INSTAGRAM_GRAPH_BASE_URL=
INSTAGRAM_GRAPH_API_VERSION=
INSTAGRAM_REQUEST_TIMEOUT_SECONDS=
INSTAGRAM_CONTAINER_POLL_ATTEMPTS=
INSTAGRAM_CONTAINER_POLL_INTERVAL_SECONDS=
INSTAGRAM_IMAGE_MAX_BYTES=
# Temporary Cloudinary copies (aquakart/instagram-temp/) are deleted this
# many minutes after verified publication (default 30).
INSTAGRAM_CLEANUP_DELAY_MINUTES=
INSTAGRAM_CLEANUP_POLL_SECONDS=
INSTAGRAM_CLEANUP_MAX_ATTEMPTS=
INSTAGRAM_CLEANUP_VERIFY_REMOTE=
INSTAGRAM_CLEANUP_WORKER_ENABLED=
