# --- Server environment (bootstrap) ---------------------------------------
# Only these two must live in .env/Doppler. Every other variable below can be
# stored in the MongoDB "aqua-env" collection (CRM: /v1/crm/env), which wins
# over .env; .env is the fallback for keys not stored there.
# Copy an existing .env into the DB with: npm run env:import -- --apply
DB_URL=
# 32 random bytes as 64 hex characters, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Losing it makes the stored values unreadable; keep a copy in a password manager.
AQUA_ENV_ENCRYPTION_KEY=
# --- Runtime configuration (aqua-env or .env) --------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
JWT_SECRET=
INVOICE_ACCESS_SECRET=
INVOICE_ACCESS_TOKEN_EXPIRY_MINUTES=15
INVOICE_ACCESS_SESSION_EXPIRY=30m
FRONTEND_PUBLIC_URL=https://aquakart.co.in
# Backward-compatible alias used by older deployments
FRONTEND_URL=https://aquakart.co.in
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Aquakart Support
SMTP_FROM_EMAIL=
# Backward-compatible full From header
EMAIL_FROM=
# Fast2SMS WhatsApp Business templates. Never commit the real API key.
FAST2SMS_API_KEY=
FAST2SMS_WHATSAPP_PHONE_NUMBER_ID=
FAST2SMS_WHATSAPP_INVOICE_MESSAGE_ID=
FAST2SMS_BASE_URL=https://www.fast2sms.com

# Reserved for the later SMS phase; no SMS sender is active yet.
FAST2SMS_SMS_ENABLED=false
FAST2SMS_SMS_ROUTE=dlt
FAST2SMS_SMS_SENDER_ID=
FAST2SMS_SMS_INVOICE_MESSAGE_ID=

# Payment-success notifications (docs/PAYMENT_NOTIFICATIONS.md). Each event is
# skipped until its approved template ID is set.
ORDER_ALERT_PHONES=9014774667
FAST2SMS_WHATSAPP_ADMIN_ORDER_MESSAGE_ID=
FAST2SMS_WHATSAPP_ORDER_CONFIRMED_MESSAGE_ID=
FAST2SMS_WHATSAPP_PAYMENT_RECEIVED_MESSAGE_ID=
FAST2SMS_WHATSAPP_PAYMENT_LINK_MESSAGE_ID=
# Optional key that seals payment-link tokens so the CRM "Send" button can
# re-send the same link. Defaults to a key derived from JWT_SECRET.
PAYMENT_LINK_TOKEN_KEY=
FAST2SMS_SMS_ADMIN_ORDER_MESSAGE_ID=
FAST2SMS_SMS_ORDER_CONFIRMED_MESSAGE_ID=
FAST2SMS_SMS_PAYMENT_RECEIVED_MESSAGE_ID=

# Weekly reminder for invoices not yet linked to a verified customer account.
# Day of week uses JavaScript numbering: 0=Sunday, 1=Monday, ..., 6=Saturday.
INVOICE_REMINDER_ENABLED=true
INVOICE_REMINDER_DAY_OF_WEEK_IST=1
INVOICE_REMINDER_HOUR_IST=8
INVOICE_REMINDER_BATCH_SIZE=100

# Commerce platform
ADMIN_BOOTSTRAP_KEY=
STANDARD_DELIVERY_CHARGE=50
ECOM_BASE_URL=https://aquakart.co.in
API_BASE_URL=https://api.aquakart.co.in
PHONEPE_MERCHANTID=
PHONEPE_KEY=
PHONEPE_KEY_INDEX=1
PHONEPE_BASE_URL=https://api.phonepe.com/apis/hermes
# Offline payment links (docs/OFFLINE_PAYMENT_LINKS.md), all optional:
# link lifetime in hours (default 72), how long a pending PhonePe attempt is
# reused in minutes (default 15), and the /pay/{token} page origin (default
# ECOM_BASE_URL).
OFFLINE_PAYMENT_LINK_TTL_HOURS=
OFFLINE_PAYMENT_ATTEMPT_TTL_MINUTES=
OFFLINE_PAYMENT_PUBLIC_BASE_URL=

# Storefront AI chat: questions per IST day. Guests are counted per IP,
# signed-in customers per account (defaults 3 and 10). Admin/tester accounts
# are unlimited.
AI_GUEST_DAILY_LIMIT=
AI_USER_DAILY_LIMIT=

# Aquakart MCP server (ChatGPT / Claude connectors). Off unless
# MCP_PUBLIC_BASE_URL is set to this API's public HTTPS origin; the MCP
# endpoint is <origin>/v1/mcp and OAuth lives at the origin root. See
# docs/MCP_BLOG_PUBLISHING.md.
MCP_PUBLIC_BASE_URL=
# Storefront origin for public blog URLs (falls back to FRONTEND_PUBLIC_URL).
MCP_STOREFRONT_URL=
# Comma-separated OAuth redirect URIs (trailing * = prefix). Default covers
# ChatGPT and Claude; loopback (Claude Code) is controlled separately.
MCP_OAUTH_ALLOWED_REDIRECT_URIS=
MCP_OAUTH_ALLOW_LOOPBACK_REDIRECTS=
MCP_ACCESS_TOKEN_TTL_SECONDS=
MCP_REFRESH_TOKEN_TTL_DAYS=
MCP_RATE_LIMIT_PER_MINUTE=
# Hosts allowed for ChatGPT file-param downloads (default *.oaiusercontent.com).
MCP_TRUSTED_FILE_HOSTS=
MCP_IMAGE_MAX_BYTES=
# Lifetime of one-time image upload URLs (aquakart_create_image_upload),
# seconds (default 600, max 3600).
MCP_UPLOAD_URL_TTL_SECONDS=
# Optional CRM link returned as adminUrl for blogs, must be https and contain
# {id}, e.g. https://admin.aquakart.co.in/blogs/{id}. Unset -> adminUrl null.
MCP_ADMIN_BLOG_URL=
MCP_PUBLISH_MIN_WORDS=
MCP_PUBLISH_REQUIRE_TITLE_IMAGE=
MCP_PUBLISH_REQUIRE_SHORT_DESCRIPTION=
MCP_OPERATION_RETENTION_DAYS=
# Cloudinary public ids of the official logo for branded blog header images.
# Default to logo_nt2v92 / logo-white_rpvptt; set to none to turn overlays off.
AQUAKART_LOGO_PUBLIC_ID=
AQUAKART_LOGO_WHITE_PUBLIC_ID=
# Optional HTTPS overrides: clean logo files given to MCP clients as image
# references, and the round badges shown on the MCP consent page.
MCP_BRAND_LOGO_URL=
MCP_BRAND_LOGO_WHITE_URL=
MCP_CONSENT_LOGO_URL=
MCP_CONSENT_LOGO_WHITE_URL=
MCP_LOGO_GRAVITY=
MCP_LOGO_WIDTH_RATIO=
# MCP invoice data-quality audit (all optional). Duplicate window compares
# the invoices' own dates in days (default 1); scan page cap (default 500)
# and maximum date range per scan (default 366 days); execution claim time
# before a retry may take over (default 120 seconds).
MCP_INVOICE_DUPLICATE_WINDOW_DAYS=
MCP_INVOICE_SCAN_MAX_INVOICES=
MCP_INVOICE_SCAN_MAX_RANGE_DAYS=
MCP_INVOICE_EXECUTION_LOCK_SECONDS=

# Instagram Content Publishing (Meta Graph API). Never commit the token.
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
# https://graph.facebook.com (Facebook Login) or https://graph.instagram.com
INSTAGRAM_GRAPH_BASE_URL=
INSTAGRAM_GRAPH_API_VERSION=
INSTAGRAM_REQUEST_TIMEOUT_SECONDS=
INSTAGRAM_CONTAINER_POLL_ATTEMPTS=
INSTAGRAM_CONTAINER_POLL_INTERVAL_SECONDS=
INSTAGRAM_IMAGE_MAX_BYTES=
# Temporary Cloudinary copies (aquakart/instagram-temp/) are deleted this
# many minutes after verified publication (default 30).
INSTAGRAM_CLEANUP_DELAY_MINUTES=
INSTAGRAM_CLEANUP_POLL_SECONDS=
INSTAGRAM_CLEANUP_MAX_ATTEMPTS=
INSTAGRAM_CLEANUP_VERIFY_REMOTE=
INSTAGRAM_CLEANUP_WORKER_ENABLED=
# GSTIN lookup for the CRM invoice form (GET /v1/crm/admin/gstin/:gstin) via
# GSTIN API (https://www.gstinapi.in, header x-api-key). Lookup stays off
# (503 GSTIN_LOOKUP_DISABLED) until the key is set. Each real lookup uses one
# credit (75 free on signup); results are cached in memory for 24 h. The
# sandbox GSTIN 00AAAAA0000A1ZT is free for testing.
GST_ENABLE_KEY=
# Optional: GSTINAPI_BASE_URL (default https://www.gstinapi.in) and
# GSTIN_LOOKUP_TIMEOUT_MS (default 15000).
GSTINAPI_BASE_URL=
GSTIN_LOOKUP_TIMEOUT_MS=
AQUA_ENV_ENCRYPTION_KEY="9b53ecbd7a38e27657f290f0adcefefe5d8467671ffd915d6d44419a6b8d2bbb"